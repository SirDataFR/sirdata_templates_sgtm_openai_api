==============================================================================*/

if (data.serverEvent) {
  data.serverEvent.forEach(o => {
    if (o.name === 'timestamp_ms') {
      event.timestamp_ms = makeInteger(o.value);
    } else if (o.name === 'opt_out') {
      event.opt_out = o.value === true || o.value === 'true';
    } else if (o.name === 'action_source') {
      event.action_source = ACTION_SOURCE_ALIASES[o.value] || o.value;
    } else if (o.name === 'custom_event_name') {
      event.type = 'custom';
      event.custom_event_name = sanitizeCustomEventName(o.value);
    } else {
      event[o.name] = o.value;
    }
  });
}

const USER_FIELD_ALIASES = {
  'email': 'emails_sha256',
  'email_sha256': 'emails_sha256',
  'phone': 'phone_numbers_sha256',
  'phone_number': 'phone_numbers_sha256',
  'phone_number_sha256': 'phone_numbers_sha256',
  'external_id': 'external_ids_sha256',
  'external_id_sha256': 'external_ids_sha256',
  'first_name': 'first_names_sha256',
  'first_name_sha256': 'first_names_sha256',
  'last_name': 'last_names_sha256',
  'last_name_sha256': 'last_names_sha256',
  'city': 'cities',
  'region': 'regions',
  'zip_code': 'postal_codes',
  'postal_code': 'postal_codes',
  'country': 'countries'
};
const USER_LIST_TRANSFORMS = {
  'emails_sha256': hashEmail,
  'phone_numbers_sha256': hashPhone,
  'external_ids_sha256': hashExternalId,
  'first_names_sha256': hashName,
  'last_names_sha256': hashName,
  'cities': function (v) { return normalizeRawString(v, 128); },
  'regions': function (v) { return normalizeRawString(v, 128); },
  'postal_codes': function (v) { return normalizeRawString(v, 32); },
  'countries': normalizeCountry
};

if (data.userData) {
  data.userData.forEach(o => {
    const name = USER_FIELD_ALIASES[o.name] || o.name;
    if (USER_LIST_TRANSFORMS[name]) {
      const list = toApiList(toList(o.value), USER_LIST_TRANSFORMS[name]);
      if (list.length > 0) {
        event.user[name] = list;
      } else {
        event.user[name] = undefined;
      }
    } else {
      event.user[name] = o.value;
    }
  });
}

if (data.customData) {
  data.customData.forEach(o => {
    if (o.name === 'value') {
      event.data.amount = toMinorUnit(o.value, event.data.currency || eventCurrency);
    } else if (o.name === 'amount') {
      event.data.amount = makeInteger(o.value);
    } else if (o.name === 'currency') {
      event.data.currency = makeString(o.value).toUpperCase();
    } else if (o.name === 'contents' && getType(o.value) === 'string') {
      event.data.contents = JSON.parse(o.value);
    } else {
      event.data[o.name] = o.value;
    }
  });
}

event.user = cleanObject(event.user);
event.data = cleanObject(event.data);
event = cleanObject(event);

/*==============================================================================
  Validation & request
==============================================================================*/

if (event.action_source === 'web' && !event.source_url) {
  data.gtmOnFailure();
  return;
}
if (event.type === 'custom' && !event.custom_event_name) {
  data.gtmOnFailure();
  return;
}
if (isValidValue(event.data.amount) && !event.data.currency) {
  event.data.amount = undefined;
  event.data = cleanObject(event.data);
}

const payload = {
  integration_source: INTEGRATION_SOURCE,
  validate_only: data.validateOnly === true || eventData.validate_only === true,
  events: [event]
};

sendHttpRequest(CAPI_ENDPOINT, (statusCode, headers, body) => {
  if (statusCode >= 200 && statusCode < 300) {
    if (consentGranted && data.generateCookies) {
      const cookieOptions = {
        domain: originDomain ? '.' + originDomain : 'auto',
        path: '/',
        samesite: 'Lax',
        secure: true,
        httpOnly: false
      };
      if (event.user.obref) {
        cookieOptions['max-age'] = BROWSER_ID_COOKIE_MAX_AGE;
        setCookie(BROWSER_ID_COOKIE, event.user.obref, cookieOptions);
      }
      if (event.oppref) {
        cookieOptions['max-age'] = CLICK_ID_COOKIE_MAX_AGE;
        setCookie(CLICK_ID_COOKIE, event.oppref, cookieOptions);
      }
    }
    data.gtmOnSuccess();
  } else {
    data.gtmOnFailure();
  }
}, {
  headers: {
    'content-type': 'application/json',
    'authorization': 'Bearer ' + makeString(data.apiKey).trim()
  },
  method: 'POST'
}, JSON.stringify(payload));


