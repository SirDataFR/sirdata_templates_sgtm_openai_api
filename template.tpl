- name: Consent via gcs - purchase mapped to order_created with hashed user data and cookies
  code: |-
    headers['gtm-helper-user-ip'] = '203.0.113.1';
    headers['gtm-helper-device-user-agent'] = 'UA/1.0';
    mock('getAllEventData', () => ({
      event_name: 'purchase', event_id: 'ev_1', 'x-ga-gcs': 'G111',
      page_location: 'https://shop.example.com/thanks?oppref=OPP123',
      currency: 'eur', value: 42.5,
      items: [{item_id: 'sku1', item_name: 'A', price: 20, quantity: 2}, {item_id: 'sku2', price: 2.5, quantity: 1}],
      user_data: {email: ' Test@Example.com ', phone_number: '+33 6 12 34 56 78', address: {first_name: 'Mary Jane', last_name: 'O\'Connor', city: 'Lyon', postal_code: '69001', country: 'fr', region: 'ARA'}}
    }));
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(request.url).isEqualTo('https://bzr.openai.com/v1/events?pid=pix_123');
    assertThat(request.options.headers.authorization).isEqualTo('Bearer sk-test');
    assertThat(request.options.method).isEqualTo('POST');
    const body = JSON.parse(request.body);
    assertThat(body.integration_source).isEqualTo('sirdata_sgtm');
    assertThat(body.validate_only).isEqualTo(false);
    const event = body.events[0];
    assertThat(event.id).isEqualTo('ev_1');
    assertThat(event.type).isEqualTo('order_created');
    assertThat(event.action_source).isEqualTo('web');
    assertThat(event.oppref).isEqualTo('OPP123');
    assertThat(event.source_url).isEqualTo('https://shop.example.com/thanks?oppref=OPP123');
    assertThat(event.timestamp_ms).isEqualTo(NOW);
    assertThat(event.user.emails_sha256).isEqualTo([sha256Sync('test@example.com', {outputEncoding: 'hex'})]);
    assertThat(event.user.phone_numbers_sha256).isEqualTo([sha256Sync('33612345678', {outputEncoding: 'hex'})]);
    assertThat(event.user.first_names_sha256).isEqualTo([sha256Sync('maryjane', {outputEncoding: 'hex'})]);
    assertThat(event.user.last_names_sha256).isEqualTo([sha256Sync('oconnor', {outputEncoding: 'hex'})]);
    assertThat(event.user.cities).isEqualTo(['Lyon']);
    assertThat(event.user.postal_codes).isEqualTo(['69001']);
    assertThat(event.user.regions).isEqualTo(['ARA']);
    assertThat(event.user.countries).isEqualTo(['FR']);
    assertThat(event.user.ip_address).isEqualTo('203.0.113.1');
    assertThat(event.user.user_agent).isEqualTo('UA/1.0');
    assertThat(event.user.obref.length).isEqualTo(36);
    assertThat(event.data.type).isEqualTo('contents');
    assertThat(event.data.amount).isEqualTo(4250);
    assertThat(event.data.currency).isEqualTo('EUR');
    assertThat(event.data.contents[0]).isEqualTo({id: 'sku1', name: 'A', quantity: 2, amount: 2000, content_type: 'product'});
    assertThat(event.data.contents[1]).isEqualTo({id: 'sku2', quantity: 1, amount: 250, content_type: 'product'});
    assertThat(cookies.__obref).isEqualTo(event.user.obref);
    assertThat(cookies.__oppref).isEqualTo('OPP123');
    assertThat(cookies._gtmeec).isNotEqualTo(undefined);
- name: Consent via Sirdata header - unknown GA4 event becomes custom, user_id hashed, _gtmeec enrichment
  code: |-
    headers['gtm-helper-consent-personalized-ads'] = 'true';
    const storedEmail = sha256Sync('a@b.fr', {outputEncoding: 'hex'});
    cookieStore._gtmeec = toBase64(JSON.stringify({em: storedEmail, fn: 'meta-only', external_id: 'U-1'}));
    cookieStore.__obref = 'ob-existing';
    mock('getAllEventData', () => ({event_name: 'My Event!', event_id: 'e2', page_location: 'https://shop.example.com/x', user_id: 'user 42'}));
    runCode(mockData);
    const event = JSON.parse(request.body).events[0];
    assertThat(event.type).isEqualTo('custom');
    assertThat(event.custom_event_name).isEqualTo('my_event');
    assertThat(event.data.type).isEqualTo('custom');
    assertThat(event.user.emails_sha256).isEqualTo([storedEmail]);
    assertThat(event.user.external_ids_sha256).isEqualTo([sha256Sync('user 42', {outputEncoding: 'hex'})]);
    assertThat(event.user.first_names_sha256).isEqualTo(undefined);
    assertThat(event.user.obref).isEqualTo('ob-existing');
    const gtmeec = JSON.parse(fromBase64(cookies._gtmeec));
    assertThat(gtmeec).isEqualTo({em: storedEmail, fn: 'meta-only', external_id: 'user 42'});
