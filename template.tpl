/*==============================================================================
  Generic helpers
==============================================================================*/

function includes(arr, element) {
  for (let i = 0; i < arr.length; i++) {
    if (arr[i] === element) { return true; }
  }
  return false;
}

function isValidValue(value) {
  const valueType = getType(value);
  return valueType !== 'null' && valueType !== 'undefined' && value !== '' && value !== 'undefined' && value !== 'null' && value !== 'redacted_for_privacy' && value === value;
}

function isSHA256Hashed(value) {
  if (!isValidValue(value)) { return false; }
  return makeString(value).match('^[A-Fa-f0-9]{64}$') !== null;
}

function hashValue(value) {
  return sha256Sync(value, {outputEncoding: 'hex'});
}

function stripChars(value, charsToRemove) {
  let result = '';
  for (let i = 0; i < value.length; i++) {
    if (charsToRemove.indexOf(value[i]) === -1) {
      result += value[i];
    }
  }
  return result;
}

function keepChars(value, charsToKeep) {
  let result = '';
  for (let i = 0; i < value.length; i++) {
    if (charsToKeep.indexOf(value[i]) !== -1) {
      result += value[i];
    }
  }
  return result;
}

const DIGITS = '0123456789';
const WHITESPACE_AND_ASCII_PUNCTUATION = ' \t\n\r!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~';

// Email: trim + lowercase. Pre-hashed values are accepted as-is.
function hashEmail(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  const email = makeString(value).trim().toLowerCase();
  if (email.indexOf('@') < 1 || email.indexOf('.', email.indexOf('@')) === -1) { return; }
  return hashValue(email);
}

// Phone: digits only (country code kept), no leading "+" and no leading zeroes, 8-15 digits.
function hashPhone(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  let digits = keepChars(makeString(value), DIGITS);
  while (digits.length > 0 && digits[0] === '0') {
    digits = digits.slice(1);
  }
  if (digits.length < 8 || digits.length > 15) { return; }
  return hashValue(digits);
}

// First/last name: lowercase, whitespace and ASCII punctuation removed, non-ASCII preserved.
function hashName(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  const name = stripChars(makeString(value).toLowerCase(), WHITESPACE_AND_ASCII_PUNCTUATION);
  if (!name) { return; }
  return hashValue(name);
}

// External ID: trim only, case preserved.
function hashExternalId(value) {
  if (!isValidValue(value)) { return; }
  if (isSHA256Hashed(value)) { return makeString(value).toLowerCase(); }
  const externalId = makeString(value).trim();
  if (!externalId) { return; }
  return hashValue(externalId);
}

function normalizeCountry(value) {
  if (!isValidValue(value)) { return; }
  const country = makeString(value).trim().toUpperCase();
  return country.length === 2 ? country : undefined;
}

function normalizeRawString(value, maxLength) {
  if (!isValidValue(value)) { return; }
  const str = makeString(value).trim();
  if (!str) { return; }
  return str.length > maxLength ? str.slice(0, maxLength) : str;
}

function isValidUUID(uuid) {
  if (!uuid || uuid.length !== 36 || uuid[8] !== '-' || uuid[13] !== '-' || uuid[18] !== '-' || uuid[23] !== '-') {
    return false;
  }
  const hexChars = '0123456789abcdefABCDEF';
  for (let i = 0; i < uuid.length; i++) {
    if (i !== 8 && i !== 13 && i !== 18 && i !== 23 && hexChars.indexOf(uuid[i]) === -1) {
      return false;
    }
  }
  return true;
}

function getValidUUID(uuid) {
  if (!uuid || !isValidUUID(uuid)) { return; }
  return uuid;
}

function generateUUID() {
  const hex = '0123456789abcdef';
  let uuid = '';
  for (let i = 0; i < 36; i++) {
    if (i === 8 || i === 13 || i === 18 || i === 23) {
      uuid += '-';
    } else if (i === 14) {
      uuid += '4';
    } else if (i === 19) {
      uuid += hex[8 + generateRandom(0, 3)];
    } else {
      uuid += hex[generateRandom(0, 15)];
    }
  }
  return uuid;
}

// Custom event names: 1-64 chars, [a-z0-9_-], must start and end with a letter or digit.
function sanitizeCustomEventName(value) {
  if (!isValidValue(value)) { return; }
  const allowed = 'abcdefghijklmnopqrstuvwxyz0123456789_-';
  const alnum = 'abcdefghijklmnopqrstuvwxyz0123456789';
  let name = '';
  const lower = makeString(value).trim().toLowerCase();
  for (let i = 0; i < lower.length; i++) {
    name += allowed.indexOf(lower[i]) !== -1 ? lower[i] : '_';
  }
  while (name.length > 0 && alnum.indexOf(name[0]) === -1) { name = name.slice(1); }
  if (name.length > 64) { name = name.slice(0, 64); }
  while (name.length > 0 && alnum.indexOf(name[name.length - 1]) === -1) { name = name.slice(0, name.length - 1); }
  return name || undefined;
}

// Amount as integer in the currency's minor unit (4200 for 42.00 USD).
function toMinorUnit(value, currency) {
  if (!isValidValue(value)) { return; }
  const zeroDecimalCurrencies = ['BIF', 'CLP', 'DJF', 'GNF', 'IDR', 'ISK', 'JPY', 'KMF', 'KRW', 'MGA', 'PYG', 'RWF', 'UGX', 'VND', 'VUV', 'XAF', 'XOF', 'XPF'];
  const threeDecimalCurrencies = ['BHD', 'IQD', 'JOD', 'KWD', 'LYD', 'OMR', 'TND'];
  const upperCurrency = currency ? makeString(currency).toUpperCase() : '';
  let multiplier = 100;
  if (includes(zeroDecimalCurrencies, upperCurrency)) {
    multiplier = 1;
  } else if (includes(threeDecimalCurrencies, upperCurrency)) {
    multiplier = 1000;
  }
  const amount = makeNumber(value);
  if (amount !== amount) { return; }
  return makeInteger(Math.round(amount * multiplier));
}

function toList(value) {
  const type = getType(value);
  let values = [];
  if (type === 'array') {
    values = value;
  } else if (type === 'string' && value.indexOf('[') === 0) {
    const parsed = JSON.parse(value);
    values = getType(parsed) === 'array' ? parsed : [value];
  } else {
    values = [value];
  }
  return values;
}

// Keeps the first 3 valid unique values (API limit).
function toApiList(values, transform) {
  const result = [];
  for (let i = 0; i < values.length; i++) {
    const transformed = transform(values[i]);
    if (isValidValue(transformed) && !includes(result, transformed)) {
      result.push(transformed);
    }
    if (result.length === 3) { break; }
  }
  return result;
}

function deepEqual(a, b) {
  if (a === b) return true;
  if (typeof a !== 'object' || a === null || typeof b !== 'object' || b === null) {
    return false;
  }
  const keysA = Object.keys(a);
  const keysB = Object.keys(b);
  if (keysA.length !== keysB.length) return false;
  for (let i = 0; i < keysA.length; i++) {
    if (!includes(keysB, keysA[i])) return false;
    if (!deepEqual(a[keysA[i]], b[keysA[i]])) return false;
  }
  return true;
}

function deepMerge(a, b) {
  let result = {};
  for (let key in a) {
    if (a.hasOwnProperty(key)) {
      result[key] = a[key];
    }
  }
  for (let key in b) {
    if (b.hasOwnProperty(key)) {
      if (typeof b[key] === 'object' && b[key] !== null && typeof result[key] === 'object' && result[key] !== null) {
        result[key] = deepMerge(result[key], b[key]);
      } else {
        result[key] = b[key];
      }
    }
  }
  return result;
}

function cleanObject(obj) {
  const cleaned = {};
  const keys = Object.keys(obj);
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];
    const value = obj[key];
    const type = getType(value);
    if (type === 'array') {
      if (value.length > 0) { cleaned[key] = value; }
    } else if (type === 'boolean' || type === 'object' || isValidValue(value)) {
      cleaned[key] = value;
    }
  }
  return cleaned;
}

/*==============================================================================
  Event metadata
==============================================================================*/

const referrer = eventData.page_referrer;
const originDomain = getValueFromHeader('gtm-helper-site-domain') || (location ? computeEffectiveTldPlusOne(location) : undefined);
const userIp = getValueFromHeader('gtm-helper-user-ip') || eventData.ip_override;

function getEventTypeInfo(eventName) {
  let name;
  if (data.eventName === 'custom') {
    name = data.customEventName;
  } else if (data.eventName === 'inherit') {
    name = GA4_MAPPINGS[eventName] || eventName;
  } else {
    name = data.eventName;
  }
  if (STANDARD_EVENTS[name]) {
    return {type: name};
  }
  return {type: 'custom', customEventName: sanitizeCustomEventName(name)};
}

function getActionSource(eventType) {
  if (eventType === 'app_installed' || eventType === 'app_opened') {
    return 'mobile_app';
  }
  let source = eventData.action_source ? makeString(eventData.action_source).toLowerCase() : 'web';
  source = ACTION_SOURCE_ALIASES[source] || source;
  return includes(ACTION_SOURCES, source) ? source : 'web';
}

function getTimestamp() {
  let ts;
  if (isValidValue(eventData.timestamp_ms)) {
    ts = makeInteger(eventData.timestamp_ms);
  } else if (isValidValue(eventData.event_time)) {
    ts = makeNumber(eventData.event_time);
    ts = ts < 100000000000 ? makeInteger(ts * 1000) : makeInteger(ts);
  }
  // API constraint: within the last 7 days and no more than 10 minutes in the future.
  if (!ts || ts !== ts || ts > tsMilli + 600000 || ts < tsMilli - 7 * 24 * 60 * 60 * 1000) {
    ts = tsMilli;
  }
  return ts;
}

function getClickIdFromUrl(url) {
  if (!url) { return; }
  const parsed = parseUrl(url);
  if (parsed && parsed.searchParams && parsed.searchParams.oppref) {
    return decodeUriComponent(parsed.searchParams.oppref);
  }
}

function getClickId() {
  let clickId = getClickIdFromUrl(location) || getClickIdFromUrl(referrer);
  if (!clickId && consentGranted) {
    clickId = getCookieValues(CLICK_ID_COOKIE)[0];
  }
  if (!clickId) {
    clickId = (eventData.common_cookie || {})[CLICK_ID_COOKIE] || eventData[CLICK_ID_COOKIE] || eventData.oppref;
  }
  return isValidValue(clickId) ? makeString(clickId) : undefined;
}

function getBrowserId() {
  if (!consentGranted) { return; }
  let browserId = getCookieValues(BROWSER_ID_COOKIE)[0] || (eventData.common_cookie || {})[BROWSER_ID_COOKIE] || eventData[BROWSER_ID_COOKIE] || eventData.obref;
  if (!isValidValue(browserId) && data.generateCookies) {
    browserId = generateUUID();
  }
  return isValidValue(browserId) ? makeString(browserId) : undefined;
}

const typeInfo = getEventTypeInfo(eventData.event_name);
let event = {user: {}, data: {}};
event.id = makeString(eventData.event_id || eventData.transaction_id || ('sirdata-sgtm-' + tsMilli + '-' + generateRandom(100000, 999999)));
event.type = typeInfo.type;
if (typeInfo.customEventName) {
  event.custom_event_name = typeInfo.customEventName;
}
event.timestamp_ms = getTimestamp();
event.action_source = getActionSource(event.type);
event.source_url = location;
event.oppref = getClickId();
if (getType(eventData.opt_out) === 'boolean') {
  event.opt_out = eventData.opt_out;
}

/*==============================================================================
  User data: GA4 user_data + Sirdata gtm-helper headers + _gtmeec enrichment
  profile keys follow the _gtmeec convention shared with the Meta CAPI tag:
  em/ph/fn/ln already hashed, external_id/ct/st/zp/country raw.
==============================================================================*/

let profile = {};
let actualCountry = true;
let actualCity = true;

if (consentGranted && data.forwardUserData) {
  const userData = eventData.user_data || {};
  profile.em = hashEmail(userData.email) || hashEmail(userData.email_address) || hashEmail(eventData.email) || hashEmail(userData.sha256_email_address) || hashEmail(getValueFromHeader('gtm-helper-user-hashed-email'));
  profile.ph = hashPhone(userData.phone_number) || hashPhone(eventData.phone_number) || hashPhone(userData.sha256_phone_number) || hashPhone(getValueFromHeader('gtm-helper-user-hashed-phone'));
  if (userData['address[0]'] && (!userData.address || !userData.address[0])) {
    userData.address = userData.address || {};
    userData.address[0] = userData['address[0]'];
  }
  let address = userData.address;
  if (getType(address) === 'array') {
    address = address[0];
  }
  if (address && getType(address) === 'object') {
    profile.fn = hashName(address.sha256_first_name) || hashName(address.first_name);
    profile.ln = hashName(address.sha256_last_name) || hashName(address.last_name);
    profile.ct = normalizeRawString(address.city, 128);
    profile.st = normalizeRawString(address.region, 128);
    profile.zp = normalizeRawString(address.postal_code, 32);
    profile.country = normalizeCountry(address.country);
  }
}

if (data.forwardIdentifiers) {
  if (consentGranted) {
    event.user.user_agent = getValueFromHeader('gtm-helper-device-user-agent') || eventData.user_agent || getValueFromHeader('user-agent');
    event.user.obref = getBrowserId();
  }
  profile.external_id = eventData.external_id || eventData.user_id || getValidUUID(getValueFromHeader('gtm-helper-cookieless-id-domain-specific'));
  event.user.ip_address = userIp;
  if (!profile.country) {
    profile.country = normalizeCountry(getValueFromHeader('gtm-helper-user-country'));
    actualCountry = false;
  }
  if (!profile.ct) {
    profile.ct = normalizeRawString(getValueFromHeader('gtm-helper-user-city'), 128);
    actualCity = false;
  }
}

// Read/write the _gtmeec cookie shared with the Sirdata Meta CAPI tag (only the keys hashed identically).
function enhanceProfile(profile) {
  if (!consentGranted || !data.generateCookies || !data.forwardUserData) {
    return profile;
  }
  let storedValues = {};
  const cookieValues = getCookieValues(ENRICHMENT_COOKIE);
  if (cookieValues && cookieValues.length > 0) {
    const decoded = fromBase64(cookieValues[0]);
    if (decoded) {
      const parsed = JSON.parse(decoded);
      if (parsed && getType(parsed) === 'object') {
        storedValues = parsed;
      }
    }
  }
  const keysToEnhance = ['em', 'ph', 'external_id'];
  let enhanced = {};
  for (let i = 0; i < keysToEnhance.length; i++) {
    const key = keysToEnhance[i];
    let value = profile[key];
    if (!isValidValue(value) && isValidValue(storedValues[key])) {
      if (key === 'external_id' || isSHA256Hashed(storedValues[key])) {
        value = storedValues[key];
      }
    }
    if (isValidValue(value)) {
      enhanced[key] = value;
    }
  }
  const toRecord = deepMerge(storedValues, enhanced);
  if (Object.keys(enhanced).length > 0 && !deepEqual(storedValues, toRecord)) {
    setCookie(ENRICHMENT_COOKIE, toBase64(JSON.stringify(toRecord)), {
      domain: getValueFromHeader('gtm-helper-server-host') || (originDomain ? '.' + originDomain : 'auto'),
      path: '/',
      samesite: 'Lax',
      secure: true,
      'max-age': ENRICHMENT_COOKIE_MAX_AGE,
      httpOnly: true
    });
  }
  return deepMerge(profile, enhanced);
}

profile = enhanceProfile(profile);

if (profile.em) { event.user.emails_sha256 = [profile.em]; }
if (profile.ph) { event.user.phone_numbers_sha256 = [profile.ph]; }
if (profile.fn) { event.user.first_names_sha256 = [profile.fn]; }
if (profile.ln) { event.user.last_names_sha256 = [profile.ln]; }
if (profile.external_id) { event.user.external_ids_sha256 = [hashExternalId(profile.external_id)]; }
if (profile.ct) { event.user.cities = [profile.ct]; }
if (profile.st) { event.user.regions = [profile.st]; }
if (profile.zp) { event.user.postal_codes = [profile.zp]; }
if (profile.country) { event.user.countries = [profile.country]; }

/*==============================================================================
  Event data (contents / customer_action / plan_enrollment / custom)
==============================================================================*/

const dataType = STANDARD_EVENTS[event.type] || 'custom';
event.data.type = dataType;

let eventCurrency = eventData.currency;
let eventValue = isValidValue(eventData.value) ? makeNumber(eventData.value) : undefined;
const itemIdKey = data.itemIdKey || 'item_id';

let items;
if (getType(eventData.items) === 'array' && eventData.items.length > 0) {
  items = eventData.items;
} else if (eventData.ecommerce && getType(eventData.ecommerce.items) === 'array' && eventData.ecommerce.items.length > 0) {
  items = eventData.ecommerce.items;
}

if (items) {
  if (!eventCurrency && items[0] && items[0].currency) {
    eventCurrency = items[0].currency;
  }
  let contents = [];
  let valueFromItems = 0;
  for (let i = 0; i < items.length; i++) {
    const item = items[i];
    if (!item || getType(item) !== 'object') { continue; }
    let content = {};
    if (isValidValue(item[itemIdKey])) { content.id = makeString(item[itemIdKey]); }
    if (isValidValue(item.item_name)) { content.name = makeString(item.item_name); }
    const quantity = isValidValue(item.quantity) ? makeInteger(item.quantity) : 1;
    content.quantity = quantity > 0 ? quantity : 1;
    if (isValidValue(item.price)) {
      content.amount = toMinorUnit(item.price, eventCurrency);
      valueFromItems += makeNumber(item.price) * content.quantity;
    }
    content.content_type = isValidValue(item.content_type) ? makeString(item.content_type) : 'product';
    let variant = {};
    if (isValidValue(item.item_variant)) { variant.variant = makeString(item.item_variant); }
    if (isValidValue(item.item_category)) { variant.category = makeString(item.item_category); }
    if (isValidValue(item.item_brand)) { variant.brand = makeString(item.item_brand); }
    if (Object.keys(variant).length > 0) { content.variant_dict = variant; }
    contents.push(cleanObject(content));
  }
  if (dataType !== 'customer_action' && contents.length > 0) {
    event.data.contents = contents;
  }
  if (eventValue === undefined && valueFromItems > 0) {
    eventValue = valueFromItems;
  }
  if (dataType === 'plan_enrollment' && items[0] && isValidValue(items[0][itemIdKey])) {
    event.data.plan_id = makeString(items[0][itemIdKey]);
  }
}

if (isValidValue(eventData.plan_id) && (dataType === 'plan_enrollment' || dataType === 'custom')) {
  event.data.plan_id = makeString(eventData.plan_id);
}
if (eventValue !== undefined && eventCurrency) {
  event.data.amount = toMinorUnit(eventValue, eventCurrency);
  event.data.currency = makeString(eventCurrency).toUpperCase();
}
if (dataType === 'custom' && isValidValue(eventData.search_term)) {
  event.data.search_string = makeString(eventData.search_term);
}

/*==============================================================================
