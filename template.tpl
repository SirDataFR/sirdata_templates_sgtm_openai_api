setup: |-
  const JSON = require('JSON');
  const sha256Sync = require('sha256Sync');
  const toBase64 = require('toBase64');
  const fromBase64 = require('fromBase64');

  const NOW = 1757000000000;
  let headers = {};
  let cookieStore = {};
  let cookies = {};
  let request = {};
  let responseStatus = 200;

  mock('getTimestampMillis', NOW);
  mock('computeEffectiveTldPlusOne', () => 'example.com');
  mock('getRequestHeader', (name) => headers[name]);
  mock('getRequestQueryParameter', () => undefined);
  mock('getCookieValues', (name) => cookieStore[name] ? [cookieStore[name]] : []);
  mock('setCookie', (name, value, options) => { cookies[name] = value; });
  mock('sendHttpRequest', (url, callback, options, body) => {
    request = {url: url, options: options, body: body};
    callback(responseStatus, {}, '');
  });

  const mockData = {
    pixelId: 'pix_123',
    apiKey: 'sk-test',
    eventName: 'inherit',
    customEventName: undefined,
    validateOnly: false,
    generateCookies: true,
    forwardUserData: true,
    forwardIdentifiers: true,
    sendWithoutConsent: false,
    itemIdKey: 'item_id',
    serverEvent: undefined,
    userData: undefined,
    customData: undefined
  };


